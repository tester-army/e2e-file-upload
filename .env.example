# Copy to .env.local. next dev reads it, and e2e.config.ts loads it for the test runner.

# Vercel Blob: the read-write token of a private store. The app and the Blob tests need it.
BLOB_READ_WRITE_TOKEN=

# The agent's model, through the Vercel AI Gateway. Only the agent test needs it.
AI_GATEWAY_API_KEY=

# Optional: test another URL. Defaults to http://localhost:3000.
# APP_URL=
